#!/bin/bash
# mel.sh - Minimal shell launcher (spec implementation prototype)

set -euo pipefail

# Requires jq
if ! command -v jq >/dev/null 2>&1; then
  echo "✖ 'jq' is required. Please install jq and retry." 1>&2
  exit 1
fi

# Determine project root (prefer VCS root; fallback to current directory)
if command -v git >/dev/null 2>&1 && git rev-parse --show-toplevel >/dev/null 2>&1; then
  PROJECT_ROOT="$(git rev-parse --show-toplevel)"
elif command -v hg >/dev/null 2>&1 && hg root >/dev/null 2>&1; then
  PROJECT_ROOT="$(hg root)"
else
  PROJECT_ROOT="$PWD"
fi

MEL_DIR="$PROJECT_ROOT/.mel"
MEL_PLUGINS_DIR="$MEL_DIR/plugins"
MEL_VERSION="0.0.1-dev"
export MEL_SELF="${BASH_SOURCE[0]}"
# Directory where this mel executable lives (for built-in defaults)
SCRIPT_DIR="$(cd "$(dirname "$MEL_SELF")" && pwd)"
DEFAULTS_DIR="$SCRIPT_DIR/plugin_defaults"

# --------------------------
# Utility helpers
# --------------------------
read_json_file() {
  local path="$1"
  if [[ -f "$path" ]]; then
    cat "$path"
  else
    echo '{}' # default empty object
  fi
}

ensure_dir() {
  mkdir -p "$1"
}

# --------------------------
# Plugin management (built-in)
# --------------------------
plugin_list() {
  if [[ -d "$MEL_PLUGINS_DIR" ]]; then
    ls -1 "$MEL_PLUGINS_DIR" | sort || true
  fi
}

plugin_remove() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: mel plugin remove <name>"; exit 1
  fi
  rm -rf "$MEL_PLUGINS_DIR/$name" || true
  # Remove from config.plugins
  local cfg
  cfg=$(read_json_file "$MEL_DIR/config.json")
  cfg=$(jq --arg p "$name" '.["plugins"] = ((.plugins // []) | map(select(. != $p)))' <<<"$cfg")
  echo "$cfg" > "$MEL_DIR/config.json"
  echo "✓ Removed plugin '$name'"
}

write_core_plugin() {
  ensure_dir "$MEL_PLUGINS_DIR/core/bin"
  cat > "$MEL_PLUGINS_DIR/core/config.json" << 'EOF'
{
  "scripts": {
    "help": {
      "description": "Show available commands",
      "mode": "basic",
      "commands": [
        "$MEL_SELF --internal-help"
      ]
    },
    "plugin": {
      "description": "Plugin management",
      "mode": "advanced",
      "usage": "mel plugin <list|install|remove|update> [name]",
      "commands": [
        "$MEL_SELF --internal-plugin $@"
      ]
    },
    "template:apply": {
      "description": "Re-apply .mel/config_template.json after init",
      "mode": "advanced",
      "usage": "mel template:apply",
      "commands": [
        "$MEL_SELF --internal-template-apply"
      ]
    },
    "mode": {
      "description": "Show or set help mode (basic|advanced)",
      "mode": "advanced",
      "usage": "mel mode [basic|advanced]",
      "commands": [
        "$MEL_SELF --internal-mode \"$@\""
      ]
    }
  },
  "hooks": {
    "pre_command": [],
    "post_command": [],
    "on_error": []
  },
  "config": {}
}
EOF
}

write_git_plugin() {
  ensure_dir "$MEL_PLUGINS_DIR/git/bin"
  cat > "$MEL_PLUGINS_DIR/git/config.json" << 'EOF'
{
  "scripts": {
    "status": {
      "description": "Show repo status",
      "mode": "basic",
      "commands": [
        "git status -sb"
      ]
    },
    "diff": {
      "description": "Show changes (staged/unstaged)",
      "mode": "advanced",
      "commands": [
        "git diff --staged --stat",
        "git diff --stat"
      ]
    },
    "save": {
      "description": "Add and commit changes",
      "mode": "basic",
      "commands": [
        "git add -A",
        "git commit -m 'mel save' || true"
      ]
    },
    "ignoremel": {
      "description": "Add .mel directory to .gitignore",
      "mode": "none",
      "commands": [
        ".mel/plugins/git/bin/ignoremel.sh"
      ]
    }
  },
  "hooks": {},
  "config": {}
}
EOF

  cat > "$MEL_PLUGINS_DIR/git/bin/ignoremel.sh" << 'EOF'
#!/bin/bash
# Add .mel to .gitignore if needed

# Check if .mel files are showing in git status
if git status --porcelain | grep -q "^?? .mel/"; then
  echo "📝 Adding .mel/ to .gitignore..."
  if [[ -f ".gitignore" ]]; then
    if ! grep -q "^\.mel/$" .gitignore; then
      echo ".mel/" >> .gitignore
      echo "✓ Added .mel/ to .gitignore"
    else
      echo "✓ .mel/ already in .gitignore"
    fi
  else
    echo ".mel/" > .gitignore
    echo "✓ Created .gitignore with .mel/"
  fi
else
  echo "✓ .mel/ already ignored or no untracked files"
fi
EOF
  chmod +x "$MEL_PLUGINS_DIR/git/bin/ignoremel.sh"
}

write_hg_plugin() {
  ensure_dir "$MEL_PLUGINS_DIR/hg/bin"
  cat > "$MEL_PLUGINS_DIR/hg/config.json" << 'EOF'
{
  "scripts": {
    "ignoremel": {
      "description": "Add .mel directory to .hgignore",
      "mode": "none",
      "commands": [
        ".mel/plugins/hg/bin/ignoremel.sh"
      ]
    }
  },
  "hooks": {},
  "config": {}
}
EOF

  cat > "$MEL_PLUGINS_DIR/hg/bin/ignoremel.sh" << 'EOF'
#!/bin/bash
# Add .mel to .hgignore if needed

if [[ -f ".hgignore" ]]; then
  if ! grep -q '^\.mel/$' .hgignore; then
    echo ".mel/" >> .hgignore
    echo "✓ Added .mel/ to .hgignore"
  else
    echo "✓ .mel/ already in .hgignore"
  fi
else
  echo ".mel/" > .hgignore
  echo "✓ Created .hgignore with .mel/"
fi
EOF
  chmod +x "$MEL_PLUGINS_DIR/hg/bin/ignoremel.sh"
}

write_mel_docs_plugin() {
  ensure_dir "$MEL_PLUGINS_DIR/mel-docs/bin"
  cat > "$MEL_PLUGINS_DIR/mel-docs/config.json" << 'EOF'
{
  "scripts": {
    "docs": {
      "description": "Start documentation server",
      "mode": "advanced",
      "usage": "mel docs [--port 8080] [--host localhost]",
      "commands": [
        ".mel/plugins/mel-docs/bin/docs.sh"
      ]
    }
  },
  "hooks": {},
  "config": {}
}

# Try to install a plugin by copying from built-in defaults
copy_defaults_plugin() {
  local name="$1"
  local src="$DEFAULTS_DIR/$name"
  local dst="$MEL_PLUGINS_DIR/$name"
  if [[ -d "$src" ]]; then
    mkdir -p "$dst"
    # Copy preserving structure
    cp -R "$src/". "$dst/"
    # Ensure any bin scripts are executable
    if [[ -d "$dst/bin" ]]; then
      chmod +x "$dst/bin"/* 2>/dev/null || true
    fi
    echo "✓ Installed plugin '$name' from defaults"
    return 0
  fi
  return 1
}
EOF

  cat > "$MEL_PLUGINS_DIR/mel-docs/bin/docs.sh" << 'EOF'
#!/bin/bash
set -euo pipefail

PORT=8080
HOST=localhost

while [[ $# -gt 0 ]]; do
  case "$1" in
    --port) PORT="$2"; shift 2;;
    --host) HOST="$2"; shift 2;;
    *) shift;;
  esac
done

if [[ -d "docs" ]]; then
  echo "→ Serving docs/ at http://$HOST:$PORT"
  (cd docs && python3 -m http.server "$PORT" --bind "$HOST")
else
  echo "✖ docs/ directory not found in repo."
  exit 1
fi
EOF
  chmod +x "$MEL_PLUGINS_DIR/mel-docs/bin/docs.sh"
}

plugin_install() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: mel plugin install <name>"; exit 1
  fi
  case "$name" in
    core)
      copy_defaults_plugin core || write_core_plugin
      ;;
    git)
      copy_defaults_plugin git || write_git_plugin
      ;;
    hg)
      copy_defaults_plugin hg || write_hg_plugin
      ;;
    mel-docs)
      copy_defaults_plugin mel-docs || write_mel_docs_plugin
      ;;
    *)
      echo "✖ Unknown plugin: $name"; exit 1
      ;;
  esac
  # Add to config.plugins
  local cfg
  cfg=$(read_json_file "$MEL_DIR/config.json")
  cfg=$(jq --arg p "$name" '.plugins = ((.plugins // []) + [$p] | unique)' <<<"$cfg")
  echo "$cfg" > "$MEL_DIR/config.json"
  echo "✓ Installed plugin '$name'"
}

plugin_update() {
  if [[ -n "${1:-}" ]]; then
    echo "✓ (stub) Updated plugin '$1'"
  else
    echo "✓ (stub) Updated all plugins"
  fi
}

run_builtin_plugin_cmd() {
  local subcmd="${1:-list}"; shift || true
  case "$subcmd" in
    list) plugin_list ;;
    install) plugin_install "${1:-}" ;;
    remove) plugin_remove "${1:-}" ;;
    update) plugin_update "${1:-}" ;;
    *) echo "Unknown plugin command: $subcmd"; exit 1 ;;
  esac
}

# --------------------------
# Template + VCS processing
# --------------------------
process_template_config() {
  if [[ -f "$MEL_DIR/config_template.json" ]]; then
    echo "📋 Found template configuration..."
    # Install plugins from template
    local plugin
    for plugin in $(jq -r '(.plugins // [])[]?' "$MEL_DIR/config_template.json" 2>/dev/null || echo ""); do
      if [[ ! -d "$MEL_PLUGINS_DIR/$plugin" ]]; then
        echo "📦 Installing plugin from template: $plugin"
        plugin_install "$plugin"
      fi
    done
    # Merge template beneath user config (user wins) using explicit field rules
    if [[ -f "$MEL_DIR/config.json" ]]; then
      jq -s '
        (.[1] // {}) as $u |
        (.[0] // {}) as $t |
        {
          plugins: ($u.plugins // []),
          scripts: (($t.scripts // {}) + ($u.scripts // {})),
          hooks: {
            pre_command: (($u.hooks.pre_command // []) + ($t.hooks.pre_command // [])),
            post_command: (($u.hooks.post_command // []) + ($t.hooks.post_command // [])),
            on_error: (($u.hooks.on_error // []) + ($t.hooks.on_error // []))
          },
          config: (($t.config // {}) + ($u.config // {}))
        }
      ' "$MEL_DIR/config_template.json" "$MEL_DIR/config.json" > "$MEL_DIR/config.json.tmp" && mv "$MEL_DIR/config.json.tmp" "$MEL_DIR/config.json"
    else
      # No user config yet; create one from template minimal fields
      jq '{plugins: [], scripts: (.scripts // {}), hooks: (.hooks // {}), config: (.config // {})}' "$MEL_DIR/config_template.json" > "$MEL_DIR/config.json"
    fi
    echo "✓ Template configuration applied"
  fi
}

detect_vcs_and_install() {
  local vcs=""
  if [[ -d "$PROJECT_ROOT/.git" ]]; then
    vcs="git"
  elif [[ -d "$PROJECT_ROOT/.hg" ]]; then
    vcs="hg"
  elif [[ -d "$PROJECT_ROOT/.svn" ]]; then
    vcs="svn"
  else
    echo "✖ No version control system detected"; return 0
  fi
  if [[ ! -d "$MEL_PLUGINS_DIR/$vcs" ]]; then
    echo "📦 Installing $vcs plugin..."
    plugin_install "$vcs"
  fi
  # Perform VCS-specific one-time setup
  if [[ "$vcs" == "git" ]]; then
    if [[ -x "$MEL_PLUGINS_DIR/git/bin/ignoremel.sh" ]]; then
      (cd "$PROJECT_ROOT" && "$MEL_PLUGINS_DIR/git/bin/ignoremel.sh" || true)
    fi
  elif [[ "$vcs" == "hg" ]]; then
    if [[ -x "$MEL_PLUGINS_DIR/hg/bin/ignoremel.sh" ]]; then
      (cd "$PROJECT_ROOT" && "$MEL_PLUGINS_DIR/hg/bin/ignoremel.sh" || true)
    fi
  fi
}

# --------------------------
# Initialization
# --------------------------
init_mel() {
  if [[ ! -d "$MEL_DIR" ]]; then
    echo "🚀 Initializing Mel..."
    ensure_dir "$MEL_PLUGINS_DIR"
    # Initial config
    cat > "$MEL_DIR/config.json" << 'EOF'
{
  "plugins": ["core"]
}
EOF
    # Install core plugin
    plugin_install core
    # Process template and detect VCS
    process_template_config
    detect_vcs_and_install
    echo "✓ Mel initialized successfully"
  fi
}

# --------------------------
# Config merging and execution
# --------------------------
load_merged_config() {
  local user_config
  user_config=$(read_json_file "$MEL_DIR/config.json")
  local merged
  merged='{"scripts":{},"hooks":{},"config":{}}'
  # Merge plugin configs in order
  local plugin
  for plugin in $(jq -r '.plugins[]?' <<<"$user_config" 2>/dev/null || true); do
    local pconf_path="$MEL_PLUGINS_DIR/$plugin/config.json"
    if [[ -f "$pconf_path" ]]; then
      merged=$(jq -n --argjson a "$merged" --slurpfile b "$pconf_path" '{
        scripts: ($a.scripts * (($b[0].scripts // {}))),
        config: ($a.config * (($b[0].config // {}))),
        hooks: {
          pre_command: (($a.hooks.pre_command // []) + (($b[0].hooks.pre_command // []))),
          post_command: (($a.hooks.post_command // []) + (($b[0].hooks.post_command // []))),
          on_error: (($a.hooks.on_error // []) + (($b[0].hooks.on_error // [])))
        }
      }')
    fi
  done
  # Merge user config on top (scripts/config overwrite; hooks append)
  merged=$(jq -n --argjson a "$merged" --argjson u "$user_config" '{
    scripts: ($a.scripts * ($u.scripts // {})),
    config: ($a.config * ($u.config // {})),
    hooks: {
      pre_command: (($a.hooks.pre_command // []) + ($u.hooks.pre_command // [])),
      post_command: (($a.hooks.post_command // []) + ($u.hooks.post_command // [])),
      on_error: (($a.hooks.on_error // []) + ($u.hooks.on_error // []))
    }
  }')
  echo "$merged"
}

execute_hooks() {
  local config_json="$1"; shift
  local hook_type="$1"; shift || true
  local hooks
  hooks=$(jq -r --arg t "$hook_type" '.hooks[$t][]?' <<<"$config_json" 2>/dev/null || true)
  local hook
  for hook in $hooks; do
    if [[ -f "$hook" ]]; then
      bash "$hook" "$@"
    else
      eval "$hook"
    fi
  done
}

execute_command() {
  local config_json="$1"; shift
  local command="$1"; shift || true
  local cmd_def
  cmd_def=$(jq -r --arg c "$command" '.scripts[$c] // empty' <<<"$config_json")
  if [[ -z "$cmd_def" ]]; then
    echo "✖ Unknown command: $command"
    echo "Run 'mel help' for available commands"
    exit 1
  fi
  # Support simple string command or object with commands array
  local entry_type
  entry_type=$(jq -r --arg c "$command" '.scripts[$c] | type' <<<"$config_json" 2>/dev/null || echo "string")
  if [[ "$entry_type" == "string" ]]; then
    execute_hooks "$config_json" "pre_command" "$command" "$@"
    eval "$cmd_def"
    execute_hooks "$config_json" "post_command" "$command" "$@"
    return
  fi
  local commands
  commands=$(jq -r --arg c "$command" '.scripts[$c].commands[]?' <<<"$config_json" 2>/dev/null || true)
  execute_hooks "$config_json" "pre_command" "$command" "$@"
  while IFS= read -r c; do
    [[ -z "$c" ]] && continue
    eval "$c"
  done <<< "$commands"
  execute_hooks "$config_json" "post_command" "$command" "$@"
}

print_help() {
  local config_json
  config_json="$(load_merged_config)"
  # Determine help mode from user config (default basic)
  local user_mode="basic"
  if [[ -f "$MEL_DIR/config.json" ]]; then
    user_mode="$(jq -r '.contributor_mode // "basic"' "$MEL_DIR/config.json" 2>/dev/null || echo basic)"
  fi
  echo "mel — repo-local plugin runner"
  echo
  echo "Available commands:"
  jq -r --arg m "$user_mode" '
    .scripts
    | to_entries[]
    | select(
        (if (.value|type)=="object" then (.value.mode // "both") else "both" end)
        as $mm
        | if $m=="basic" then ($mm=="basic" or $mm=="both") else ($mm != "none") end
      )
    | "  \(.key)\t\(if (.value|type) == "object" then (.value.description // "") else "" end)"
  ' <<<"$config_json" | sort
  echo
  echo "Use: mel <command> [args]"
}

# --------------------------
# Main
# --------------------------
if [[ "${1:-}" == "-v" || "${1:-}" == "--version" ]]; then
  echo "$MEL_VERSION"; exit 0
fi
if [[ "${1:-}" == "--internal-version" ]]; then
  echo "$MEL_VERSION"; exit 0
fi
if [[ "${1:-}" == "--internal-help" ]]; then
  print_help; exit 0
fi
if [[ "${1:-}" == "--internal-plugin" ]]; then
  shift || true
  run_builtin_plugin_cmd "$@"; exit 0
fi
if [[ "${1:-}" == "--internal-template-apply" ]]; then
  process_template_config; exit 0
fi
if [[ "${1:-}" == "--internal-mode" ]]; then
  shift || true
  arg="${1:-}"
  if [[ -z "$arg" ]]; then
    if [[ -f "$MEL_DIR/config.json" ]]; then
      jq -r '.contributor_mode // "basic"' "$MEL_DIR/config.json"
    else
      echo "basic"
    fi
    exit 0
  fi
  case "$arg" in
    basic|advanced) :;;
    *) echo "✖ Mode must be 'basic' or 'advanced'"; exit 1;;
  esac
  if [[ -f "$MEL_DIR/config.json" ]]; then
    jq --arg m "$arg" '.contributor_mode = $m' "$MEL_DIR/config.json" > "$MEL_DIR/config.json.tmp" && mv "$MEL_DIR/config.json.tmp" "$MEL_DIR/config.json"
  else
    echo "{\"contributor_mode\": \"$arg\"}" > "$MEL_DIR/config.json"
  fi
  echo "✓ Switched to $arg mode"
  exit 0
fi

command="${1:-help}"; shift || true

# Initialize if needed
init_mel

case "$command" in
  help)
    print_help
    ;;
  plugin)
    run_builtin_plugin_cmd "$@"
    ;;
  *)
    config_json="$(load_merged_config)"
    execute_command "$config_json" "$command" "$@"
    ;;
esac


